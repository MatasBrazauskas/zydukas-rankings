# Firebase Web app config — Firebase console > Project settings > Your apps > Web app.
# These values are public by design (they identify the project, they do not authorize anything).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=zydukas-rankings.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=zydukas-rankings
VITE_FIREBASE_STORAGE_BUCKET=zydukas-rankings.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Routes on the Go API. Both go through the Vite dev proxy (see vite.config.ts),
# so in dev they stay relative; in production point them at the deployed API.
VITE_USERS_CONTROLLER=/api/users
VITE_POSTS_CONTROLLER=/api/posts
